# Configuración del Servidor en Render / Producción
PORT=3000
NODE_ENV=production

# Base de Datos MongoDB (Para Render, usa tu URI de MongoDB Atlas)
# Ejemplo: mongodb+srv://<usuario>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
DB_NAME=literaturaProyect

# Seguridad JWT
JWT_SECRET=c4f9a3e2d1b708654c9f2e1a3b8d7c6f5e4a9b0c1d2e3f4a5b6c7d8e9f0a1b2c
JWT_EXPIRES_IN=7d

# Google OAuth (Obtenido de Google Cloud Console)
GOOGLE_CLIENT_ID=tu_google_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui

# URL del Frontend desplegado en Vercel (para CORS)
# Ejemplo: https://literatura-proyect.vercel.app
FRONTEND_URL=http://localhost:4200

# Correo del Administrador Principal (Super Admin)
ADMIN_EMAIL=ludwingivanvasqueznavas@gmail.com
